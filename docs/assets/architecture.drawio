        <mxCell id="n2-bar" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;fillColor=#53D9D4;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="589" y="700" width="3" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Fresh membership never waits for classifiers&lt;/span&gt;&lt;div style=&quot;height:6px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#91A4AE;&quot;&gt;Results carry forward only while the exact txid and wtxid survive. Unresolved facts stay collection state, never a manufactured verdict.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#E8F2F4;" vertex="1" parent="1">
          <mxGeometry x="608" y="698" width="480" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="n3-bar" value="" style="rounded=1;absoluteArcSize=1;arcSize=3;fillColor=#E1AA4B;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1130" y="700" width="3" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Nothing is retained&lt;/span&gt;&lt;div style=&quot;height:6px&quot;&gt;&lt;/div&gt;&lt;span style=&quot;color:#91A4AE;&quot;&gt;No database, queue, delta protocol, ZMQ feed, node-side agent, or history. A restart discards current state until a new valid observation arrives.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#E8F2F4;" vertex="1" parent="1">
          <mxGeometry x="1149" y="698" width="480" height="76" as="geometry"/>
        </mxCell>
      </root>
