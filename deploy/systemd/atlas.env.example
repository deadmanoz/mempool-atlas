ATLAS_SOURCES_FILE=/etc/mempool-atlas/sources.json
ATLAS_CREDENTIALS_DIRECTORY=/etc/mempool-atlas/credentials
ATLAS_BIND=127.0.0.1:3101
ATLAS_WEB_ROOT=/opt/mempool-atlas/web/dist
ATLAS_POLL_SECONDS=300
ATLAS_MAX_MEMPOOL_ENTRIES=200000
ATLAS_CLASSIFICATION_SLICE_ENTRIES=2048
ATLAS_CLASSIFICATION_RPC_LANES=4
ATLAS_CLASSIFICATION_TOTAL_CACHE_MIB=256
RUST_LOG=info
